.page {
  padding: 28rpx;
}

.hero,
.section {
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 46rpx rgba(34, 57, 44, 0.08);
}

.hero {
  padding: 32rpx;
  background: linear-gradient(135deg, #e3f3ea 0%, #ffffff 68%);
}

.hero-row,
.section-head,
.score-card,
.field-row,
.chat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eyebrow,
.subtitle,
.section-tag,
.label,
.score-label,
.stat-label,
.food-macro,
.community-text {
  color: #65756b;
}

.eyebrow {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #2f8a57;
}

.title {
  display: block;
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
}

.refresh {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: #123324;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 76rpx;
}

.refresh::after,
.chip::after,
.segmented button::after,
.chat-row button::after {
  border: 0;
}

.score-card {
  margin-top: 34rpx;
}

.score {
  display: block;
  font-size: 72rpx;
  font-weight: 800;
}

.score-label {
  font-size: 24rpx;
}

.ring {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  padding: 14rpx;
  background: #2f8a57;
}

.ring-core {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #2f8a57;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.stat-grid {
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
}

.stat {
  flex: 1;
  min-height: 112rpx;
  padding: 18rpx 14rpx;
  border: 1rpx solid #dce4dd;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
}

.stat-value {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.section {
  margin-top: 24rpx;
  padding: 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
}

.section-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #edf6f1;
  color: #2f8a57;
  font-size: 22rpx;
}

.form-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 24rpx;
}

.field {
  width: calc(50% - 9rpx);
  min-height: 132rpx;
  padding: 18rpx;
  border: 1rpx solid #dce4dd;
  border-radius: 14rpx;
  background: #fbfdfb;
}

.field.full {
  width: 100%;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
}

.field-value,
.picker-value,
input {
  color: #1e2b24;
  font-size: 28rpx;
  font-weight: 700;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.chip {
  min-width: 150rpx;
  height: 62rpx;
  border-radius: 999rpx;
  background: #eef4ef;
  color: #1e2b24;
  font-size: 24rpx;
  line-height: 62rpx;
}

.chip-active {
  background: #2f8a57;
  color: #ffffff;
}

.food-stage {
  position: relative;
  height: 380rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #eef4ed;
}

.plate {
  position: absolute;
  border-radius: 50%;
}

.plate-main {
  left: 50%;
  top: 50%;
  width: 300rpx;
  height: 300rpx;
  transform: translate(-50%, -50%);
  background: #ffffff;
  border: 16rpx solid #d8dfd7;
}

.plate-a {
  left: 190rpx;
  top: 92rpx;
  width: 94rpx;
  height: 94rpx;
  background: #69a874;
}

.plate-b {
  left: 318rpx;
  top: 118rpx;
  width: 104rpx;
  height: 104rpx;
  background: #f0c75e;
}

.plate-c {
  left: 270rpx;
  top: 210rpx;
  width: 114rpx;
  height: 114rpx;
  background: #d87b63;
}

.noodle .plate-a {
  background: #f1d588;
}

.noodle .plate-b {
  background: #56a067;
}

.noodle .plate-c {
  background: #cf5546;
}

.salad .plate-a {
  background: #5ba96a;
}

.salad .plate-b {
  background: #98c96e;
}

.salad .plate-c {
  background: #efc65a;
}

.nutrition-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.94);
}

.food-name {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.food-macro {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
}

.segmented {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.scan-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.scan-actions button {
  flex: 1;
  height: 68rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 68rpx;
}

.scan-primary {
  background: #2f8a57;
  color: #ffffff;
}

.scan-secondary {
  background: #eef4ef;
  color: #1e2b24;
}

.recognition-status {
  display: block;
  margin-top: 12rpx;
  color: #65756b;
  font-size: 23rpx;
  line-height: 1.5;
}

.segmented button {
  flex: 0 0 auto;
  min-width: 148rpx;
  height: 68rpx;
  border-radius: 14rpx;
  background: #eef4ef;
  color: #1e2b24;
  font-size: 24rpx;
  line-height: 68rpx;
}

.segmented .selected {
  background: #2f8a57;
  color: #ffffff;
}

.recommendation {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-left: 8rpx solid #2f8a57;
  border-radius: 14rpx;
  background: #f7fbf8;
  color: #1e2b24;
  font-size: 26rpx;
  line-height: 1.65;
}

.coach-message {
  min-height: 146rpx;
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #f7fbf8;
  font-size: 26rpx;
  line-height: 1.7;
}

.chat-row {
  gap: 14rpx;
  margin-top: 18rpx;
}

.chat-row input {
  flex: 1;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dce4dd;
  border-radius: 14rpx;
  background: #fbfdfb;
  font-size: 26rpx;
}

.chat-row button {
  width: 120rpx;
  height: 76rpx;
  border-radius: 14rpx;
  background: #2f8a57;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 76rpx;
}

.community-card {
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #f7fbf8;
}

.community-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
}

.community-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
