page {
  min-height: 100%;
  background: #f5f7f4;
  color: #1e2b24;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
picker,
slider {
  box-sizing: border-box;
}

button {
  margin: 0;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
